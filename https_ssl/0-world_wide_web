#!/usr/bin/env bash
# A Bash script that prints information about subdomains with a unique structure.

get_sub_info() {
  local domain=$1
  local subdomain=$2
  local full="${subdomain}.${domain}"

  # Get only the last record (resolves even when CNAME exists)
  local line
  line=$(dig +noall +answer "$full" | tail -n1)

  local type
  type=$(echo "$line" | awk '{print $4}')

  local dest
  dest=$(echo "$line" | awk '{print $5}')

  echo "The subdomain ${subdomain} is a ${type} record and points to ${dest}"
}

domain=$1
subdomain=$2

if [[ -z "$subdomain" ]]; then
  for s in www lb-01 web-01 web-02; do
    get_sub_info "$domain" "$s"
  done
else
  get_sub_info "$domain" "$subdomain"
fi
