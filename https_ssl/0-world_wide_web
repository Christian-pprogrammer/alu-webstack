#!/usr/bin/env bash
# Prints only the destination IP of a subdomain

function get_ip {
  local domain=$1
  local sub=$2
  local full="${sub}.${domain}"

  # Resolve the final IP even if CNAME exists
  local ip
  ip=$(dig +short "$full" | tail -n1)

  echo "$ip"
}

domain=$1
sub=$2

if [[ -z "$sub" ]]; then
  for s in www lb-01 web-01 web-02; do
    get_ip "$domain" "$s"
  done
else
  get_ip "$domain" "$sub"
fi
