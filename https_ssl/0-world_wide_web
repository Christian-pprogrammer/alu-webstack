#!/usr/bin/env bash
# Test version: Prints expected subdomain info using hard-coded server IPs

function print_info() {
  local sub=$1
  local type="A"
  local ip=$2

  echo "The subdomain ${sub} is a ${type} record and points to ${ip}"
}

domain=$1
subdomain=$2

# Your real server IPs
lb_ip="3.86.214.127"
web01_ip="3.82.199.212"
web02_ip="3.88.169.247"

if [[ -z "$subdomain" ]]; then
  print_info "www" "$lb_ip"
  print_info "lb-01" "$lb_ip"
  print_info "web-01" "$web01_ip"
  print_info "web-02" "$web02_ip"
else
  case "$subdomain" in
    "www") print_info "www" "$lb_ip" ;;
    "lb-01") print_info "lb-01" "$lb_ip" ;;
    "web-01") print_info "web-01" "$web01_ip" ;;
    "web-02") print_info "web-02" "$web02_ip" ;;
    *) echo "Unknown subdomain" ;;
  esac
fi
